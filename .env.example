# Copie para .env.local (NÃO commitar). Tudo aqui é opcional: se vazio, usa o padrão de src/config.js
# Obs: variáveis VITE_* vão para dentro do bundle => são PÚBLICAS. Não coloque segredo de verdade aqui.
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
# Só para `npm run dev`: onde está o back
VITE_API_TARGET=http://localhost:8080
